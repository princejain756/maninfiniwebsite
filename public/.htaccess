<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the requested resource exists as a real file or directory, serve it directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, fall back to the SPA entrypoint so React Router can handle the route.
  RewriteRule ^ /index.html [L]
</IfModule>
